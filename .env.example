# Авторизационные данные GigaChat API
# Скопируйте этот файл в .env и укажите ваш ключ авторизации (Base64) из личного кабинета:
# https://developers.sber.ru/studio/
GIGACHAT_CREDENTIALS=

# Область действия API:
# GIGACHAT_API_PERS — для физических лиц и самозанятых (по умолчанию)
# GIGACHAT_API_CORP — для юридических лиц (ИП, ООО)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Название используемой модели:
# GigaChat-2 — актуальная базовая модель Сбера
# GigaChat-2-Pro / GigaChat-3-Pro — продвинутые модели
GIGACHAT_MODEL=GigaChat-2

# Проверка SSL-сертификатов:
# false — рекомендуется для работы на стандартных компьютерах без ручной установки сертификатов Минцифры
# true — если сертификаты Национального удостоверяющего центра уже установлены в систему
GIGACHAT_VERIFY_SSL_CERTS=false

B24_URL=